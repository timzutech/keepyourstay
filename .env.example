# ─── Site ────────────────────────────────────────────────────────────────
# Public URL of the site, no trailing slash. Change this when you connect a domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (Project Settings → API) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. A long random string of your own;
# its SHA-256 hash is stored in the database (see README → Supabase setup).
# The form handlers must present it to save an enquiry or a subscriber.
FORMS_SECRET=

# ─── Email (Resend — https://resend.com) ─────────────────────────────────
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
EMAIL_FROM="KeepYourStay <hello@your-domain.com>"
# Where lead notifications are delivered.
LEAD_NOTIFICATION_EMAIL=KeepYourStay@gmail.com

# ─── Business contact defaults (can be overridden in Admin → Settings) ───
NEXT_PUBLIC_BUSINESS_EMAIL=KeepYourStay@gmail.com
# Digits only, international format, no "+" or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=19514692722

# ─── Analytics (optional) ────────────────────────────────────────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Loaded only after analytics consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Advertising (optional; each loads only after advertising consent) ───
# Google Ads tag ID, e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label of the "Lead" conversion action in Google Ads (the part after the slash in AW-123456789/AbC-dEfGhIjK)
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Meta (Facebook/Instagram) Pixel ID, digits only
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Spam protection ─────────────────────────────────────────────────────
# Any long random string. Used to hash visitor IPs for rate limiting.
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# ─── Legal pages ─────────────────────────────────────────────────────────
# The privacy, terms and cookie pages show a "template pending legal review"
# notice until this is set to true. Only change it after a lawyer has reviewed them.
NEXT_PUBLIC_LEGAL_REVIEWED=false
